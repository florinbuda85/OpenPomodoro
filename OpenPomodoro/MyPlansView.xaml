<Controls:MetroWindow x:Class="OpenPomodoro.MyPlansView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        Title="My plans" Height="460" Width="760" MinHeight="300" MinWidth="500"
        ShowMinButton="False" GlowBrush="{DynamicResource AccentColorBrush}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Add plan" Width="100" Click="AddPlan_Click" />
            <Button x:Name="EditButton" Content="Edit" Width="80" Margin="8,0,0,0"
                    IsEnabled="False" Click="EditPlan_Click" />
            <Button x:Name="DeleteButton" Content="Delete" Width="80" Margin="8,0,0,0"
                    IsEnabled="False" Click="DeletePlan_Click" />
        </StackPanel>
        <DataGrid x:Name="PlansGrid" Grid.Row="1"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  SelectionChanged="PlansGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Plan" Binding="{Binding Content}" Width="*" />
                <DataGridTextColumn Header="Pomodoros completed" Binding="{Binding PomodoroCount}" Width="160" />
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="{x:Type DataGridRow}">
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="PlanRow_RightClick" />
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Start with this plan" Click="StartPlan_Click" />
                                <Separator />
                                <MenuItem Header="Edit" Click="EditPlan_Click" />
                                <MenuItem Header="Delete" Click="DeletePlan_Click" />
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
        <TextBlock Grid.Row="2" Margin="0,10,0,0"
                   Text="Right-click a plan to start a Pomodoro with it." />
    </Grid>
</Controls:MetroWindow>
