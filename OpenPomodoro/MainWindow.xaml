<Controls:MetroWindow  x:Class="OpenPomodoro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:local="clr-namespace:OpenPomodoro"
        GlowBrush="{DynamicResource AccentColorBrush}" 
        ShowTitleBar="false"
         ShowMaxRestoreButton="False"
                       ShowMinButton="False"
                       ShowCloseButton="False"
                       
        mc:Ignorable="d"
        Title="MainWindow" Height="73" Width="525" Topmost="True" ResizeMode="NoResize" AllowsTransparency="True" WindowStyle="None" >

    <!--Controls:MetroWindow.Background>
        <SolidColorBrush Color="White" Opacity="0.5"/>
    </-->

    <Grid Background="Transparent" PreviewMouseLeftButtonDown="WindowSurface_MouseLeftButtonDown">

        <StackPanel Width="497" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0">
            <ProgressBar Name="mainBar" Height="8" MinHeight="0" Value="78" />
            <Canvas Name="dayTimeline" Height="{Binding ActualHeight, ElementName=mainBar}"
                    Margin="0,3,0,0" Background="Gray" ClipToBounds="True" />
        </StackPanel>

        <TextBlock Margin="14,41,0,0"
                   Text="{Binding CompletedPomodoroCount}"
                   ToolTip="Pomodoros completed today"
                   Width="40"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top" />

        <TextBlock Margin="60,41,60,0"
                   Text="{Binding CenterText}"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Top" />

        <TextBlock Margin="14,1,439,55" Text="{Binding TextTimePassed}"  TextAlignment="Left" />
        <TextBlock Margin="401,1,14,55" Text="{Binding TextTimeLeft}"  TextAlignment="Right"/>


    </Grid>

    <Controls:MetroWindow.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Start work" Name="menuStartWork" Click="menuStartWork_Click"/>
            <MenuItem Header="Start with a plan" Name="menuStartWithPlan" Click="MenuStartWithPlan_Click"/>
            <MenuItem Header="Cancel progress" Name="menuCancelProgres" Click="menuCancelProgress_Click" />
            <MenuItem Header="Force complete" Name="menuForceCompleteProgres" Click="menuForceCompleteProgres_Click" />

            <MenuItem Header="Start Short Pause" Name="menuStartShortPause" Click="menuStartShortPause_Click" />
            <MenuItem Header="Start Long Pause" Name="menuStartLongPause" Click="menuStartLongPause_Click" />
            <Separator />
            <MenuItem Header="View Chart" Name="menuChart" Click="MenuChart_Click" />
            <MenuItem Header="My plans .." Click="MenuMyPlans_Click" />
            <MenuItem Header="Settings.." Name="menuSettings" Click="MenuSettings_Click" />
            <MenuItem Header="Add Pause Reminder" Name="menuAddPauseReminder" Click="MenuAddPauseReminder_Click" />
            <MenuItem Header="Pause Reminders.." Name="menuPauseAdvices" Click="MenuPauseAdvices_Click" />
            <Separator />
            <MenuItem Header="EXIT" Name="menuExit" Click="MenuExit_Click" />
        </ContextMenu>
    </Controls:MetroWindow.ContextMenu>

</Controls:MetroWindow>
